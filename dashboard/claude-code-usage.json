{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0,211,255,1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 100,
      "panels": [],
      "title": "Summary (all sources)",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(increase(claude_code_cost_usage_USD_total[$__range]))",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Total Cost (USD)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "A session = one Claude Code run, from launch to exit. In CI, each claude-code-review.yml job triggered on a PR is one session \u2014 reviewing the same PR again after new commits adds another.",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(last_over_time(claude_code_session_count_total[$__range]))",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Total Sessions",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "purple",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(increase(claude_code_token_usage_tokens_total[$__range]))",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Total Tokens",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(last_over_time(claude_code_active_time_seconds_total[$__range])) / 3600",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Active Time (hours)",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 101,
      "panels": [],
      "title": "Cost & Tokens",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "claude-sonnet-5"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "blue",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "claude-haiku-4-5-20251001"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "id": 5,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (model) (increase(claude_code_cost_usage_USD_total{ci_pr_author=~\"$ci_pr_author\"}[$__interval]))",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ],
      "title": "Cost Trend Over Time",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "claude-sonnet-5"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "blue",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "claude-haiku-4-5-20251001"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 14
      },
      "id": 6,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        },
        "pieType": "donut"
      },
      "targets": [
        {
          "expr": "sum by (model) (increase(claude_code_cost_usage_USD_total{ci_pr_author=~\"$ci_pr_author\"}[$__range]))",
          "instant": true,
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ],
      "title": "Cost by Model",
      "type": "piechart"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 14
      },
      "id": 7,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        },
        "pieType": "donut"
      },
      "targets": [
        {
          "expr": "sum by (type) (increase(claude_code_token_usage_tokens_total{ci_pr_author=~\"$ci_pr_author\"}[$__range]))",
          "instant": true,
          "legendFormat": "{{type}}",
          "refId": "A"
        }
      ],
      "title": "Token Usage by Type",
      "type": "piechart"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "id": 102,
      "panels": [],
      "title": "By Repo / PR",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Covers CI runs. Interactive usage is included as well wherever telemetry is enabled on developer machines.",
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "id": 8,
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "text": {
          "titleSize": 14,
          "valueSize": 16
        }
      },
      "targets": [
        {
          "expr": "sum by (ci_repo) (increase(claude_code_cost_usage_USD_total{ci_pr_author=~\"$ci_pr_author\"}[$__range]))",
          "instant": true,
          "legendFormat": "{{ci_repo}}",
          "refId": "A"
        }
      ],
      "title": "Cost by Repo",
      "type": "bargauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "A session = one Claude Code run, from launch to exit. In CI, each claude-code-review.yml job triggered on a PR is one session \u2014 reviewing the same PR again after new commits adds another. Covers CI runs. Interactive usage is included as well wherever telemetry is enabled on developer machines.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "id": 9,
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "text": {
          "titleSize": 14,
          "valueSize": 16
        }
      },
      "targets": [
        {
          "expr": "sum by (ci_repo) (last_over_time(claude_code_session_count_total{ci_pr_author=~\"$ci_pr_author\"}[$__range]))",
          "instant": true,
          "legendFormat": "{{ci_repo}}",
          "refId": "A"
        }
      ],
      "title": "Sessions by Repo",
      "type": "bargauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Covers CI runs. Interactive usage is included as well wherever telemetry is enabled on developer machines. Sessions = one Claude Code run each. \"Data as of\" is this query's evaluation time (same for every row) \u2014 not the PR's created or last-pushed date, which Prometheus doesn't track.",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Cost (USD)"
              },
              {
                "id": "unit",
                "value": "currencyUSD"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Tokens"
              },
              {
                "id": "unit",
                "value": "short"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #C"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Sessions"
              },
              {
                "id": "unit",
                "value": "short"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ci_pr"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "targetBlank": true,
                    "title": "Open PR #${__value.text} on GitHub",
                    "url": "https://github.com/${__data.fields[\"ci_repo\"]}/pull/${__data.fields[\"ci_pr\"]}"
                  },
                  {
                    "targetBlank": false,
                    "title": "View Claude conversation for PR #${__value.text}",
                    "url": "/d/claude-code-usage/claude-code-usage?${__url_time_range}&var-ci_pr_log=${__value.text}&var-ci_repo_log=${__data.fields[\"ci_repo\"]}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Data as of"
              },
              {
                "id": "unit",
                "value": "time:DD-MM-YYYY"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "id": 10,
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "expr": "sum by (ci_repo, ci_pr) (label_replace(increase(claude_code_cost_usage_USD_total{ci_pr_author=~\"$ci_pr_author\"}[$__range]), \"ci_pr\", \"(no PR)\", \"ci_pr\", \"^$\"))",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "sum by (ci_repo, ci_pr) (label_replace(increase(claude_code_token_usage_tokens_total{ci_pr_author=~\"$ci_pr_author\"}[$__range]), \"ci_pr\", \"(no PR)\", \"ci_pr\", \"^$\"))",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "expr": "sum by (ci_repo, ci_pr) (label_replace(last_over_time(claude_code_session_count_total{ci_pr_author=~\"$ci_pr_author\"}[$__range]), \"ci_pr\", \"(no PR)\", \"ci_pr\", \"^$\"))",
          "format": "table",
          "instant": true,
          "refId": "C"
        }
      ],
      "title": "Repo / PR Breakdown",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        }
      ],
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 43
      },
      "id": 105,
      "panels": [],
      "title": "PR Conversation",
      "type": "row"
    },
    {
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 44
      },
      "id": 106,
      "options": {
        "content": "Click \"View Claude conversation\" on a row in the Repo / PR Breakdown table above to load a PR's conversation here \u2014 repo and PR # are set together from that row, so this panel always matches the row you clicked. It shows `user_prompt` events only \u2014 the review request sent to Claude; assistant responses and tool calls are not included. Only runs made while content logging was enabled have real text \u2014 runs from before that show blank or REDACTED content. Long entries are truncated to ~600 characters for readability.",
        "mode": "markdown"
      },
      "title": "",
      "type": "text"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "description": "Requires content logging (OTEL_LOG_USER_PROMPTS / OTEL_LOG_ASSISTANT_RESPONSES / OTEL_LOG_TOOL_DETAILS) to have been on for that run.",
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 47
      },
      "id": 107,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Ascending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{service_name=\"claude-code\"} | ci_repo=\"$ci_repo_log\" | ci_pr=\"$ci_pr_log\" | event_name=\"user_prompt\" | line_format \"PROMPT: {{.prompt | trunc 600}}\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "PR Conversation \u2014 ${ci_repo_log} #${ci_pr_log}",
      "type": "logs"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 63
      },
      "id": 103,
      "panels": [],
      "title": "Per Developer",
      "type": "row"
    },
    {
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 64
      },
      "id": 11,
      "options": {
        "content": "For CI-sourced data, rows are grouped by `ci_pr_author` \u2014 the GitHub username of whoever opened the PR (requires the `claude-code-review.yml` workflow to add `ci.pr_author` to `OTEL_RESOURCE_ATTRIBUTES`; PRs reviewed before that is in place won't have this label). `user_id` is a separate, random ID Claude Code regenerates on every CI run, since GitHub runners don't persist state between runs \u2014 it does NOT identify a person in CI. Where telemetry is enabled on developer machines, `user_id` is persisted per machine and does identify an interactive user, so these panels can be extended to include it.",
        "mode": "markdown"
      },
      "title": "",
      "type": "text"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Grouped by the GitHub PR author, which is available for CI runs. Interactive usage is attributed by `user_id` instead, wherever telemetry is enabled on developer machines.",
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "targetBlank": false,
              "title": "Filter dashboard to ${__field.labels.ci_pr_author}",
              "url": "/d/claude-code-usage/claude-code-usage?${__url_time_range}&var-ci_pr_author=${__field.labels.ci_pr_author}"
            }
          ],
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
